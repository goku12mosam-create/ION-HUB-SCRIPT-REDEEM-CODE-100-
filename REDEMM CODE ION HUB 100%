local function MakeCard(parent, pos, size)
    local f = Instance.new("Frame", parent)
    f.Position = pos
    f.Size = size
    f.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
    f.BorderSizePixel = 0
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
    local s = Instance.new("UIStroke", f)
    s.Color = Color3.fromRGB(70, 70, 70)
    s.Thickness = 1
    return f
end

local function MakeToggle(parent, state)
    local b = Instance.new("TextButton", parent)
    b.Size = UDim2.new(0, 42, 0, 24)
    b.Position = UDim2.new(1, -48, 0.5, -12)
    b.Font = Enum.Font.GothamBlack
    b.TextSize = 10
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    local function Refresh(val)
        b.Text = val and "ON" or "OFF"
        b.BackgroundColor3 = val and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(38, 38, 38)
        b.TextColor3 = val and Color3.fromRGB(10, 10, 10) or Color3.fromRGB(200, 200, 200)
    end
    Refresh(state)
    return b, Refresh
end

